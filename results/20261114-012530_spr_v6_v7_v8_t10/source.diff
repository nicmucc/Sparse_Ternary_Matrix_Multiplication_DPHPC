+// Interleaved bindings and thread changes must refresh the rectangle plan.
+// Sentinel outputs also catch unwritten all-zero groups and tails.
+static std::pair<int, int> check_spr_rectangles(Kernel& kern) {
+    const int saved_threads = omp_get_max_threads();
+    int pass = 0, fail = 0;
+    for (const char* pattern : {"iid", "column_clustered", "all_zero"}) {
+        const bool zeros = std::string(pattern) == "all_zero";
+        std::vector<Problem> problems;
+        for (int M : {1, 35, 99, 515})
+            problems.push_back(make_problem(M, 129, 193, zeros ? 1.0 : 0.75, 10124,
+                                            -1, zeros ? "iid" : pattern));
+
+        Params p; p.k = 3;
+        kern.prepare(problems.front().W.data(), 129, 193, p);
+        IO empty{0, 129, 193, nullptr, nullptr};
+        kern.run(empty); // Empty inference must also work without bind().
+        set_threads(1);
+        std::vector<std::unique_ptr<Bound>> bindings;
+        for (const auto& P : problems) bindings.push_back(std::make_unique<Bound>(&kern, P));
+        for (size_t i = 0; i < problems.size(); ++i) {
+            const auto& P = problems[i];
+            auto& b = *bindings[i];
+            for (int threads : {1, 2, 4, 6, 8, 10, 12, 14}) {
+                set_threads(threads);
+                bool ok = true;
+                for (int repeat = 0; repeat < 2; ++repeat) {
+                    std::fill_n(b.Y.p, b.Y.n, 123.f);
+                    b.run();
+                    kern.finish(b.io);
+                    for (int m = 0; m < P.M; ++m)
+                        for (int n = 0; n < P.N; ++n)
+                            if (!(std::fabs(b.Y.p[(size_t)n * P.M + m] -
+                                            P.Yref[(size_t)m * P.N + n]) <= tolerance(P.K))) ok = false;
+                }
+                if (ok) ++pass;
+                else {
+                    ++fail;
+                    std::printf("    wrong rectangles: %s M=%d threads=%d\n", pattern, P.M, threads);
+                }
+            }
+        }
+    }
+    set_threads(saved_threads);
+    return {pass, fail};
+}
